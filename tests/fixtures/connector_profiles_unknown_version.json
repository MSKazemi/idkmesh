[
  {
    "api_version": "idkmesh.io/v9",
    "id": "jules-main",
    "kind": "agent",
    "driver": "jules",
    "enabled": true,
    "auth": {
      "secret_ref": "env:JULES_API_KEY"
    },
    "settings": {
      "source": "sources/github/MSKazemi/idkmesh",
      "starting_branch": "main",
      "require_plan_approval": true
    },
    "capabilities": {
      "tiers": ["T1", "T2"],
      "tools": ["git"],
      "candidate_types": ["github_pull_request"]
    },
    "policy": {
      "task_classes": ["coder"],
      "allowed_risk": ["low"],
      "external_processing": true,
      "project_spend_usd_max": 0,
      "max_concurrency": 1
    },
    "independence": {
      "provider_family": "google",
      "agent_family": "jules",
      "execution_family": "jules-hosted"
    }
  },
  {
    "api_version": "idkmesh.io/v9",
    "id": "local-goose",
    "kind": "agent",
    "driver": "cli",
    "enabled": true,
    "settings": {
      "preset": "goose"
    },
    "capabilities": {
      "tiers": ["T1", "T2"],
      "task_classes": ["coder"],
      "tools": ["git", "pytest"],
      "candidate_types": ["artifact_bundle"],
      "max_risk": "medium"
    },
    "policy": {
      "external_processing": false,
      "project_spend_usd_max": 0,
      "max_concurrency": 1
    },
    "independence": {
      "provider_family": "local",
      "agent_family": "goose",
      "execution_family": "local-docker"
    }
  }
]
