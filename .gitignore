__pycache__/
*.py[cod]
.venv/
results/

# Python packaging byproducts of `pip install .` from the source tree
build/
dist/
*.egg-info/
.claude/

# Private per-agent instruction files. These carry local configuration and
# personal notes, so in this public repository they must never be committed.
# AGENTS.md is deliberately NOT ignored: unlike CLAUDE.md it holds no private
# config, it is the public agents.md contributor standard that coding agents read.
CLAUDE.md
GEMINI.md
.note
.note.*

# Secrets and machine-local overrides
.env
.env.*
*.local

# Editor and OS byproducts
.vscode/
.DS_Store

# E015 worker output written to the repo root during sweeps
/e015-*.jsonl

# paper/: LaTeX build byproducts and figures regenerated by `make figures`
# from committed experiment artifacts (see paper/Makefile) -- derived, not
# source. main.pdf is committed as a reader convenience; these are not.
paper/main.aux
paper/main.bbl
paper/main.blg
paper/main.log
paper/main.out
paper/figures/

# reference audit: third-party copyrighted PDFs used to verify citations,
# never commit
paper/reference-audit-workspace/
