{
  "budget": {
    "compute_units": 1,
    "human_minutes": 2,
    "paid_fallback_allowed": false,
    "project_spend_usd_max": 0,
    "tokens": 0,
    "wall_seconds": 60
  },
  "constraints": {
    "allowed_paths": [
      "README.md"
    ],
    "forbidden_paths": [
      ".github/**",
      "SECURITY.md"
    ],
    "policies": [
      "candidate-only",
      "independent-verification-required",
      "zero-project-spend"
    ]
  },
  "context": {
    "references": [
      "schemas/work-unit-v0.2.schema.json",
      "schemas/node-execution-binding-v0.1.schema.json",
      "schemas/result-manifest-v0.1.schema.json",
      "config/compute-policy.json"
    ],
    "summary": "Integration fixture for canonical Work Unit v0.2 -> node binding -> worker ResultManifest v0.1."
  },
  "dependencies": [],
  "evidence_requirements": [
    {
      "required": true,
      "type": "artifact_hash"
    },
    {
      "required": true,
      "type": "review"
    }
  ],
  "extensions": {
    "org.idkmesh.node.execution": {
      "capabilities": [
        "git",
        "container-execution",
        "python"
      ],
      "container": {
        "command": [
          "python",
          "-c",
          "from pathlib import Path; p=Path('README.md'); p.write_text(p.read_text() + chr(10) + '<!-- idkmesh-node candidate smoke -->' + chr(10))"
        ],
        "image": "python:3.12-alpine"
      },
      "limits": {
        "cpus": 1.0,
        "memory_mb": 256,
        "pids_limit": 64,
        "timeout_seconds": 30
      },
      "output_limits": {
        "max_log_bytes": 262144,
        "max_patch_bytes": 1000000
      },
      "schema_version": "0.1",
      "source_input_id": "source-repository",
      "source_revision": "b1397a9be91da6570e8ae370de4fa9f4bc44df5c"
    }
  },
  "failure_semantics": {
    "max_attempts": 1,
    "on_failure": "stop",
    "retryable": false
  },
  "id": "node/canonical-smoke",
  "inputs": [
    {
      "id": "source-repository",
      "locator": "https://github.com/MSKazemi/idkmesh",
      "type": "git_ref"
    }
  ],
  "kind": "testing",
  "objective": "Produce a harmless tracked-file candidate patch inside the bounded local node sandbox.",
  "outputs": [
    {
      "description": "Unverified candidate patch generated by the local node.",
      "id": "candidate-patch",
      "media_type": "text/x-diff",
      "type": "patch"
    }
  ],
  "permissions": {
    "filesystem_write": [
      "README.md"
    ],
    "network": "none",
    "network_allowlist": [],
    "process_execution": true,
    "secrets": []
  },
  "provenance": {
    "created_by": "idkmesh-project",
    "creator_type": "system",
    "source": "canonical node integration work",
    "source_revision": "b1397a9be91da6570e8ae370de4fa9f4bc44df5c"
  },
  "requirements": {
    "capabilities": [
      "git",
      "container-execution",
      "python"
    ],
    "resources": {
      "accelerator_capabilities": [],
      "cpu_cores_min": 0.5,
      "disk_mb_min": 1,
      "gpu": "none",
      "memory_mb_min": 128
    }
  },
  "schema_version": "0.2",
  "security": {
    "data_classification": "public",
    "minimum_worker_trust": "untrusted",
    "notes": "Controlled Docker smoke task only; not an arbitrary hostile Internet workload.",
    "risk_class": "low",
    "sandbox_required": true
  },
  "uncertainty": [],
  "validators": [
    {
      "description": "Worker output must validate as ResultManifest v0.1.",
      "id": "result-manifest-schema",
      "required": true,
      "type": "schema"
    },
    {
      "description": "A party independent of the worker must evaluate the candidate.",
      "id": "independent-review",
      "required": true,
      "type": "review"
    }
  ],
  "verification_policy": {
    "acceptance_rule": "All required validators must pass; successful worker execution remains an unverified candidate.",
    "independent_from_worker": true,
    "minimum_independent_verifiers": 1,
    "strategy": "all_required"
  },
  "version": 2
}
