{
  "version": 7,
  "queue_label": "agent-ready",
  "dispatch_label": "agent:jules-dispatched",
  "legacy_dispatch_labels": [
    "jules"
  ],
  "max_in_flight": 4,
  "max_dispatch_per_sweep": 2,
  "blocked_labels": [
    "blocked",
    "do-not-automate",
    "human-required",
    "needs-decomposition",
    "research-evidence",
    "security-sensitive",
    "agent:jules-needs-attention",
    "agent:jules-completed"
  ],
  "priority_weights": {
    "priority:p0": 300,
    "priority:p1": 200,
    "priority:p2": 100
  },
  "size_weights": {
    "size:xs": 40,
    "size:s": 30,
    "size:m": 10
  },
  "bonus_weights": {
    "bug": 15,
    "good first issue": 10,
    "documentation": 5
  },
  "label_definitions": {
    "agent-ready": {
      "color": "0E8A16",
      "description": "Maintainer-approved for bounded coding-agent execution"
    },
    "jules": {
      "color": "EDEDED",
      "description": "Legacy/manual Google Jules GitHub App trigger; not added by automation"
    },
    "blocked": {
      "color": "D93F0B",
      "description": "Cannot proceed until a named blocker is resolved"
    },
    "do-not-automate": {
      "color": "B60205",
      "description": "Explicitly excluded from coding-agent auto-dispatch"
    },
    "human-required": {
      "color": "C5DEF5",
      "description": "Requires genuine human observation, judgment, or evidence"
    },
    "research-evidence": {
      "color": "D4C5F9",
      "description": "Requires independent research or measurement evidence"
    },
    "security-sensitive": {
      "color": "B60205",
      "description": "Security-sensitive task requiring explicit review"
    },
    "needs-decomposition": {
      "color": "FBCA04",
      "description": "Too broad for automatic dispatch; split into bounded tasks first"
    },
    "priority:p0": {
      "color": "B60205",
      "description": "Highest implementation priority"
    },
    "priority:p1": {
      "color": "D93F0B",
      "description": "High implementation priority"
    },
    "priority:p2": {
      "color": "FBCA04",
      "description": "Normal implementation priority"
    },
    "size:xs": {
      "color": "0E8A16",
      "description": "Very small bounded change"
    },
    "size:s": {
      "color": "0E8A16",
      "description": "Small bounded change"
    },
    "size:m": {
      "color": "FBCA04",
      "description": "Medium bounded change"
    },
    "agent:jules-dispatched": {
      "color": "5319E7",
      "description": "Reserved/started by the API-backed Jules dispatcher"
    },
    "agent:jules-eligible": {
      "color": "BFDADC",
      "description": "Trusted low-risk bounded task routed for automatic Jules REST dispatch"
    },
    "agent:jules-needs-attention": {
      "color": "D93F0B",
      "description": "Jules session needs maintainer inspection before redispatch"
    },
    "agent:jules-completed": {
      "color": "1D76DB",
      "description": "Jules session finished and candidate review reservation is resolved; requires explicit re-triage before redispatch"
    }
  },
  "automatic_queue_label": "agent:jules-eligible",
  "trusted_author_associations": [
    "OWNER",
    "MEMBER",
    "COLLABORATOR"
  ],
  "attention_label": "agent:jules-needs-attention",
  "attention_session_states": [
    "FAILED",
    "AWAITING_PLAN_APPROVAL",
    "AWAITING_USER_FEEDBACK",
    "PAUSED",
    "STATE_UNSPECIFIED"
  ],
  "stale_session_minutes": {
    "QUEUED": 120,
    "PLANNING": 180,
    "IN_PROGRESS": 360
  },
  "stale_missing_session_minutes": 60,
  "session_scan_max_pages": 10,
  "provider_concurrency": {
    "max_concurrent_tasks": 3,
    "plan": "Jules",
    "source": "https://jules.google/docs/usage-limits",
    "checked_at": "2026-09-23",
    "terminal_session_states": [
      "COMPLETED",
      "FAILED"
    ],
    "session_state_source": "https://jules.google/docs/api/reference/types/"
  },
  "ci_backpressure": {
    "enabled": true,
    "max_queued_runs": 12,
    "max_in_progress_runs": 8,
    "source": "https://docs.github.com/en/rest/actions/workflow-runs?apiVersion=2022-11-28#list-workflow-runs-for-a-repository",
    "checked_at": "2026-09-23"
  },
  "completion_label": "agent:jules-completed"
}
