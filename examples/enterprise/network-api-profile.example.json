{
  "kind": "idkmesh-network-api-profile",
  "schema_version": "0.1",
  "profile_id": "team-api-example",
  "bind": {
    "host": "10.20.0.5",
    "port": 8443
  },
  "tls": {
    "mode": "trusted_proxy_terminated",
    "trusted_proxies": ["10.20.0.0/28"]
  },
  "authentication": {
    "adapter": "oidc",
    "issuer": "idp.example.org",
    "credential_transport": "authorization_header",
    "max_token_lifetime_seconds": 3600
  },
  "request_policy": {
    "allowed_hosts": ["api.idkmesh.example.org"],
    "allowed_origins": ["https://ui.idkmesh.example.org"],
    "max_body_bytes": 1048576,
    "rate_limit": {
      "principal_requests_per_minute": 120,
      "principal_burst": 20,
      "anonymous_requests_per_minute": 30,
      "anonymous_burst": 5,
      "max_tracked_keys": 10000
    }
  },
  "audit": {
    "record_denials": true
  }
}
