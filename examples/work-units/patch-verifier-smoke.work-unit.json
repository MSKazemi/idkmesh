{
  "budget": {
    "compute_units": 0,
    "human_minutes": 0,
    "paid_fallback_allowed": false,
    "project_spend_usd_max": 0,
    "tokens": 0,
    "wall_seconds": 10
  },
  "constraints": {
    "allowed_paths": ["README.md"],
    "forbidden_paths": [".github/**", "SECURITY.md"],
    "policies": ["candidate-only", "independent-verification-required", "zero-project-spend"]
  },
  "context": {
    "references": [
      "schemas/work-unit-v0.2.schema.json",
      "schemas/result-manifest-v0.1.schema.json",
      "schemas/evaluator-plan-v0.2.schema.json"
    ],
    "summary": "Deterministic patch-evaluator fixture mirroring the canonical node bundle shape."
  },
  "dependencies": [],
  "evidence_requirements": [
    {"required": true, "type": "artifact_hash"},
    {"required": true, "type": "review"}
  ],
  "extensions": {},
  "failure_semantics": {"max_attempts": 1, "on_failure": "stop", "retryable": false},
  "id": "verification/patch-smoke",
  "inputs": [{"id": "source-repository", "locator": "https://github.com/MSKazemi/idkmesh", "type": "git_ref"}],
  "kind": "testing",
  "objective": "Verify a bounded unified-diff candidate without executing candidate code.",
  "outputs": [{"description": "Unverified candidate patch.", "id": "candidate-patch", "media_type": "text/x-diff", "type": "patch"}],
  "permissions": {"filesystem_write": ["README.md"], "network": "none", "network_allowlist": [], "process_execution": false, "secrets": []},
  "provenance": {"created_by": "idkmesh-project", "creator_type": "system", "source": "patch evaluator fixture", "source_revision": "patch-verifier-fixture-v1"},
  "requirements": {"capabilities": ["git"], "resources": {"accelerator_capabilities": [], "cpu_cores_min": 0.1, "disk_mb_min": 1, "gpu": "none", "memory_mb_min": 32}},
  "schema_version": "0.2",
  "security": {"data_classification": "public", "minimum_worker_trust": "untrusted", "notes": "Fixture only; candidate code is never executed by the evaluator.", "risk_class": "low", "sandbox_required": false},
  "uncertainty": [],
  "validators": [
    {"description": "Worker output must validate as ResultManifest v0.1.", "id": "result-manifest-schema", "required": true, "type": "schema"},
    {"description": "Independent evaluator must verify artifact/log integrity, patch scope, and verifier-owned semantic expectation.", "id": "independent-review", "required": true, "type": "review"}
  ],
  "verification_policy": {"acceptance_rule": "Both required validators must pass; worker self-report is not acceptance.", "independent_from_worker": true, "minimum_independent_verifiers": 1, "strategy": "all_required"},
  "version": 1
}
