{
  "schema_version": "0.2",
  "id": "verification/deterministic-bundle",
  "version": 1,
  "kind": "testing",
  "objective": "Verify a bounded candidate patch by recomputing its artifact digest and checking changed paths against the Work Unit scope.",
  "context": {
    "summary": "Fixture for the deterministic independent verifier. The candidate patch is evidence input, not trusted worker truth.",
    "references": [
      "schemas/verification-result-v0.1.schema.json",
      "verifier/README.md"
    ],
    "max_context_bytes": 32768
  },
  "inputs": [
    {
      "id": "source-repository",
      "type": "git_ref",
      "locator": "https://github.com/MSKazemi/idkmesh"
    }
  ],
  "outputs": [
    {
      "id": "candidate-patch",
      "type": "patch",
      "description": "A bounded patch that may modify README.md only.",
      "media_type": "text/x-diff"
    }
  ],
  "dependencies": [],
  "requirements": {
    "capabilities": [
      "git-patch-generation"
    ],
    "resources": {
      "cpu_cores_min": 0.1,
      "memory_mb_min": 64,
      "disk_mb_min": 1,
      "gpu": "none",
      "accelerator_capabilities": []
    }
  },
  "constraints": {
    "allowed_paths": [
      "README.md"
    ],
    "forbidden_paths": [
      ".github/**",
      "SECURITY.md"
    ],
    "policies": [
      "candidate-only",
      "independent-verification-required",
      "no-project-paid-compute"
    ]
  },
  "uncertainty": [],
  "security": {
    "risk_class": "low",
    "data_classification": "public",
    "minimum_worker_trust": "untrusted",
    "sandbox_required": false,
    "notes": "The verifier reads static files only and does not execute candidate code."
  },
  "permissions": {
    "network": "none",
    "network_allowlist": [],
    "filesystem_write": [
      "README.md"
    ],
    "secrets": [],
    "process_execution": false
  },
  "verification_policy": {
    "strategy": "all_required",
    "independent_from_worker": true,
    "minimum_independent_verifiers": 1,
    "acceptance_rule": "ResultManifest schema, declared work-unit digest, candidate artifact digest, and path policy must all pass."
  },
  "validators": [
    {
      "id": "result-manifest-schema",
      "type": "schema",
      "required": true,
      "description": "Validate the worker ResultManifest against the canonical schema."
    },
    {
      "id": "work-unit-digest",
      "type": "reproduction",
      "required": true,
      "description": "Recompute the canonical Work Unit digest and compare it with worker provenance."
    },
    {
      "id": "artifact-digests",
      "type": "reproduction",
      "required": true,
      "description": "Recompute SHA-256 for produced artifacts/logs that declare digests."
    },
    {
      "id": "path-policy",
      "type": "review",
      "required": true,
      "description": "Parse patch paths and reject changes outside allowed_paths or matching forbidden_paths."
    }
  ],
  "evidence_requirements": [
    {
      "type": "artifact_hash",
      "required": true,
      "description": "Independent SHA-256 evidence for the candidate patch."
    },
    {
      "type": "review",
      "required": true,
      "description": "Independent deterministic path-policy assessment."
    }
  ],
  "budget": {
    "wall_seconds": 10,
    "compute_units": 0.01,
    "human_minutes": 0,
    "tokens": 0,
    "project_spend_usd_max": 0,
    "paid_fallback_allowed": false
  },
  "provenance": {
    "created_by": "IDKMesh deterministic verifier",
    "creator_type": "system",
    "source": "Issue #5",
    "parent_work_unit_ids": []
  },
  "failure_semantics": {
    "retryable": false,
    "max_attempts": 1,
    "on_failure": "escalate"
  },
  "extensions": {
    "org.idkmesh.verifier.fixture": true
  }
}
