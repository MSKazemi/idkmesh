{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/verifier-observation-pool-v0.1.schema.json",
  "title": "IDKMesh Verifier Observation Pool v0.1",
  "description": "A point-in-time, domain-scoped view of verifier availability, validator coverage, independence, cost, and reliability evidence for advisory verifier-allocation research. It is not a durable reputation record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "source_revision",
    "captured_at",
    "work_unit_id",
    "task_domain",
    "worker_id",
    "reliability_max_age_days",
    "verifier_candidates",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "idkmesh-verifier-observation-pool"},
    "repository": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "work_unit_id": {"type": "string", "minLength": 1},
    "task_domain": {"type": "string", "minLength": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "reliability_max_age_days": {
      "type": "integer",
      "minimum": 1
    },
    "verifier_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/verifier"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "available",
        "supported_validator_ids",
        "review_units",
        "queue_load",
        "independence",
        "reliability"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "provider_family": {"type": ["string", "null"]},
        "available": {"type": "boolean"},
        "supported_validator_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "review_units": {"type": "number", "minimum": 0},
        "queue_load": {"type": "number", "minimum": 0},
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "independent_from_worker",
            "shared_model_family",
            "shared_runtime"
          ],
          "properties": {
            "independent_from_worker": {"type": "boolean"},
            "shared_model_family": {"type": "boolean"},
            "shared_runtime": {"type": "boolean"}
          }
        },
        "reliability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "alpha",
            "beta",
            "sample_count",
            "domain",
            "observed_at",
            "shift_warning",
            "source_refs",
            "known_bad_probe_trials",
            "known_bad_probe_breaches"
          ],
          "properties": {
            "basis": {
              "enum": [
                "live_outcomes",
                "known_bad_probes",
                "synthetic",
                "unknown"
              ]
            },
            "alpha": {"type": "number", "minimum": 1},
            "beta": {"type": "number", "minimum": 1},
            "sample_count": {"type": "integer", "minimum": 0},
            "domain": {"type": "string", "minLength": 1},
            "observed_at": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "shift_warning": {"type": "boolean"},
            "source_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "known_bad_probe_trials": {
              "type": "integer",
              "minimum": 0
            },
            "known_bad_probe_breaches": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}