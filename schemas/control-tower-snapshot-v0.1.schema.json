{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/control-tower-snapshot-v0.1.schema.json",
  "title": "IDKMesh Control Tower Snapshot v0.1",
  "description": "A deterministic, read-only human-facing projection of one validated Run Evidence Report v0.1. It separates worker claims, independent evidence/recommendations, attention conditions, and pending human authority without selecting or integrating a candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "schema_version",
    "kind",
    "source",
    "work_unit",
    "summary",
    "attention",
    "attempts",
    "timeline",
    "warnings",
    "human_decision",
    "authority",
    "interpretation_rules"
  ],
  "properties": {
    "api_version": {
      "const": "v1"
    },
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "idkmesh-control-tower-snapshot"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence_report_digest",
        "schema_version",
        "run_id",
        "source_run_digest",
        "source_config_digest",
        "verifier_policy_digest"
      ],
      "properties": {
        "kind": {
          "const": "idkmesh-run-evidence-report"
        },
        "evidence_report_digest": {
          "$ref": "#/$defs/digest"
        },
        "schema_version": {
          "const": "0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "source_run_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_config_digest": {
          "$ref": "#/$defs/digest"
        },
        "verifier_policy_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_count",
        "supported",
        "rejected",
        "inconclusive",
        "control_errors",
        "verification_disagreement",
        "control_failure_present"
      ],
      "properties": {
        "attempt_count": {
          "type": "integer",
          "minimum": 1
        },
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        },
        "control_errors": {
          "type": "integer",
          "minimum": 0
        },
        "verification_disagreement": {
          "type": "boolean"
        },
        "control_failure_present": {
          "type": "boolean"
        }
      }
    },
    "attention": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attention"
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selected_attempt_id",
        "integration_authority"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "selected_attempt_id": {
          "type": "null"
        },
        "integration_authority": {
          "const": "external_human_or_governance"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_state_write",
        "git_push",
        "merge",
        "automatic_candidate_selection"
      ],
      "properties": {
        "canonical_state_write": {
          "const": false
        },
        "git_push": {
          "const": false
        },
        "merge": {
          "const": false
        },
        "automatic_candidate_selection": {
          "const": false
        }
      }
    },
    "interpretation_rules": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "claim": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "worker_id",
        "worker_status",
        "result_manifest_id",
        "result_manifest_digest"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "worker_status": {
          "type": "string",
          "minLength": 1
        },
        "result_manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "result_manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "verifier_id",
        "verifier_status",
        "recommendation",
        "verification_digest",
        "checks"
      ],
      "properties": {
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "verifier_status": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "enum": [
            "accept_candidate",
            "reject_candidate",
            "escalate",
            "insufficient_evidence"
          ]
        },
        "verification_digest": {
          "$ref": "#/$defs/digest"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "order",
        "state",
        "evidence_state",
        "worker_adapter",
        "claim",
        "evidence",
        "error"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "verified",
            "worker_error",
            "result_manifest_error",
            "verification_error"
          ]
        },
        "evidence_state": {
          "enum": [
            "supported",
            "rejected",
            "inconclusive",
            "worker_error",
            "result_manifest_error",
            "verification_error"
          ]
        },
        "worker_adapter": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "$ref": "#/$defs/claim"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "title",
        "why"
      ],
      "properties": {
        "severity": {
          "enum": [
            "high",
            "medium",
            "action"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "type",
        "title",
        "detail",
        "actor",
        "attempt_id",
        "evidence_ref"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "observation",
            "claim",
            "evidence",
            "recommendation",
            "control_error",
            "attention",
            "authority"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
