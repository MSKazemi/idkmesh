{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/evaluator-plan-v0.1.schema.json",
  "title": "IDKMesh Evaluator Plan v0.1",
  "description": "Verifier-controlled metadata-only evaluation plan. The plan may be public or hidden from the worker and must remain outside the candidate workspace when independence is required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "binding",
    "visibility",
    "execution_mode",
    "verifier",
    "source_revision",
    "checks",
    "baseline",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_id", "work_unit_version", "work_unit_digest"],
      "properties": {
        "work_unit_id": {"type": "string", "minLength": 1},
        "work_unit_version": {"type": "integer", "minimum": 1},
        "work_unit_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "visibility": {"enum": ["public", "hidden"]},
    "execution_mode": {"const": "metadata_only"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "adapter"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["human", "agent", "system", "hybrid"]},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "provider": {"type": "string"},
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string"}
          }
        }
      }
    },
    "source_revision": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required", "builtin"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["test", "review", "schema", "lint", "security", "formal", "reproduction", "policy", "other"]},
          "required": {"type": "boolean"},
          "builtin": {"enum": ["input_schema", "scope", "artifact_digest", "provenance", "verification_request"]},
          "description": {"type": "string"}
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "complete", "files", "ignore_paths"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "complete": {"const": true},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "ignore_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_plan_outside_candidate_root",
        "reject_symlinks",
        "require_source_revision_match",
        "require_candidate_local_artifacts"
      ],
      "properties": {
        "require_plan_outside_candidate_root": {"const": true},
        "reject_symlinks": {"const": true},
        "require_source_revision_match": {"type": "boolean"},
        "require_candidate_local_artifacts": {"const": true}
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
