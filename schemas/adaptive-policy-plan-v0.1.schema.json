{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/adaptive-policy-plan-v0.1.schema.json",
  "title": "IDKMesh Adaptive Policy Shadow Plan v0.1",
  "description": "A non-authoritative exact-revision recommendation emitted by an adaptive policy operating only inside a hard-gated eligible set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "planner_version",
    "mode",
    "plan_id",
    "subsystem",
    "binding",
    "policy",
    "hard_gates",
    "eligible_choices",
    "recommendation",
    "evidence_refs",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "idkmesh-adaptive-policy-plan"},
    "planner_version": {"const": "0.1"},
    "mode": {"const": "shadow"},
    "plan_id": {
      "type": "string",
      "pattern": "^adaptive-plan-[a-z0-9][a-z0-9._-]*-[a-f0-9]{12}$"
    },
    "subsystem": {
      "enum": [
        "task-routing",
        "verification-allocation",
        "compute-path-routing",
        "community-policy",
        "other"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_revision_sha",
        "input_digest",
        "input_refs"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "source_revision_sha": {"$ref": "#/$defs/sha"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "input_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "maturity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "maturity": {"enum": ["N1", "N2", "N3"]}
      }
    },
    "hard_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "eligible_choices": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/choice"}
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_choice_id",
        "baseline_choice_id",
        "exploration",
        "reasons",
        "uncertainty",
        "expected_cost"
      ],
      "properties": {
        "selected_choice_id": {"type": ["string", "null"]},
        "baseline_choice_id": {"type": ["string", "null"]},
        "exploration": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "uncertainty": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "expected_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_spend_usd",
            "compute_units",
            "review_units",
            "human_attention_units"
          ],
          "properties": {
            "project_spend_usd": {"const": 0},
            "compute_units": {"type": ["number", "null"], "minimum": 0},
            "review_units": {"type": ["number", "null"], "minimum": 0},
            "human_attention_units": {"type": ["number", "null"], "minimum": 0}
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "dispatch",
        "execute",
        "approve",
        "merge",
        "repository_write",
        "relax_hard_gates",
        "modify_required_verification",
        "authorize_project_spend"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "dispatch": {"const": false},
        "execute": {"const": false},
        "approve": {"const": false},
        "merge": {"const": false},
        "repository_write": {"const": false},
        "relax_hard_gates": {"const": false},
        "modify_required_verification": {"const": false},
        "authorize_project_spend": {"const": false}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "reasons", "metrics"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean", "null"]
          }
        }
      }
    }
  }
}