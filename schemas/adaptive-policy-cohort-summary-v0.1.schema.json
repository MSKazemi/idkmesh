{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/adaptive-policy-cohort-summary-v0.1.schema.json",
  "title": "IDKMesh Adaptive Policy Shadow Cohort Summary v0.1",
  "description": "A descriptive evaluation of immutable adaptive-policy shadow plans joined to observed real-process outcomes. It does not estimate an unobserved counterfactual policy effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evaluator_version",
    "summary_id",
    "policy_ids",
    "counts",
    "disagreement",
    "observed_outcomes",
    "measurement_coverage",
    "identifiability",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "idkmesh-adaptive-policy-cohort-summary"},
    "evaluator_version": {"const": "0.1"},
    "summary_id": {
      "type": "string",
      "pattern": "^adaptive-cohort-[a-f0-9]{12}$"
    },
    "policy_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plans",
        "outcomes",
        "joined",
        "missing_outcomes",
        "duplicate_outcomes_rejected"
      ],
      "properties": {
        "plans": {"type": "integer", "minimum": 0},
        "outcomes": {"type": "integer", "minimum": 0},
        "joined": {"type": "integer", "minimum": 0},
        "missing_outcomes": {"type": "integer", "minimum": 0},
        "duplicate_outcomes_rejected": {"const": 0}
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shadow_vs_baseline_comparable",
        "shadow_vs_baseline_disagree",
        "shadow_vs_baseline_disagreement_rate",
        "shadow_matches_actual",
        "baseline_matches_actual",
        "neither_matches_actual"
      ],
      "properties": {
        "shadow_vs_baseline_comparable": {"type": "integer", "minimum": 0},
        "shadow_vs_baseline_disagree": {"type": "integer", "minimum": 0},
        "shadow_vs_baseline_disagreement_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "shadow_matches_actual": {"type": "integer", "minimum": 0},
        "baseline_matches_actual": {"type": "integer", "minimum": 0},
        "neither_matches_actual": {"type": "integer", "minimum": 0}
      }
    },
    "observed_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_outcomes",
        "successful",
        "success_rate",
        "escaped_defects",
        "escaped_defect_rate",
        "high_risk_escapes",
        "high_risk_escape_rate",
        "mean_verified_utility"
      ],
      "properties": {
        "known_outcomes": {"type": "integer", "minimum": 0},
        "successful": {"type": "integer", "minimum": 0},
        "success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "escaped_defects": {"type": "integer", "minimum": 0},
        "escaped_defect_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "high_risk_escapes": {"type": "integer", "minimum": 0},
        "high_risk_escape_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "mean_verified_utility": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "measurement_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_utility",
        "escaped_defect",
        "high_risk_escape",
        "project_spend_usd",
        "compute_units",
        "review_units",
        "human_attention_units"
      ],
      "properties": {
        "verified_utility": {"$ref": "#/$defs/coverage"},
        "escaped_defect": {"$ref": "#/$defs/coverage"},
        "high_risk_escape": {"$ref": "#/$defs/coverage"},
        "project_spend_usd": {"$ref": "#/$defs/coverage"},
        "compute_units": {"$ref": "#/$defs/coverage"},
        "review_units": {"$ref": "#/$defs/coverage"},
        "human_attention_units": {"$ref": "#/$defs/coverage"}
      }
    },
    "identifiability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptive_only",
        "shadow_counterfactual_observed",
        "causal_effect_estimate",
        "promotion_decision_automatic"
      ],
      "properties": {
        "descriptive_only": {"const": true},
        "shadow_counterfactual_observed": {"const": false},
        "causal_effect_estimate": {"type": "null"},
        "promotion_decision_automatic": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_only",
        "dispatch",
        "execute",
        "approve",
        "merge",
        "repository_write"
      ],
      "properties": {
        "evidence_only": {"const": true},
        "dispatch": {"const": false},
        "execute": {"const": false},
        "approve": {"const": false},
        "merge": {"const": false},
        "repository_write": {"const": false}
      }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "total", "rate"],
      "properties": {
        "observed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}