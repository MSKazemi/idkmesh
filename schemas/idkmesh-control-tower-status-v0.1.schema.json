{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/idkmesh-control-tower-status-v0.1.schema.json",
  "title": "IDKMesh Control Tower Status v0.1",
  "description": "The authenticated discovery/status document returned by `GET /api/v1/status` (docs/specifications/CONTROL_TOWER_LOCAL_API_V0_1.md). It publishes accepted media types, source/output schema URLs, explicitly enabled read capabilities, explicitly disabled actuation capabilities, and the endpoint list -- it performs no action of its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version", "schema_version", "kind", "ok", "service", "mode",
    "media_types", "source_contracts", "schemas", "capabilities",
    "operations", "endpoints"
  ],
  "properties": {
    "api_version": {"const": "v1"},
    "schema_version": {"const": "0.1"},
    "kind": {"const": "idkmesh-control-tower-status"},
    "ok": {"const": true},
    "service": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "media_types": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "source_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "format": "uri"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_evidence_inspection", "semantic_timeline", "provenance_chain",
        "human_decision_recording", "worker_execution",
        "canonical_state_write", "git_push", "merge",
        "automatic_candidate_selection"
      ],
      "properties": {
        "run_evidence_inspection": {"type": "boolean"},
        "semantic_timeline": {"type": "boolean"},
        "provenance_chain": {"type": "boolean"},
        "human_decision_recording": {"const": false},
        "worker_execution": {"const": false},
        "canonical_state_write": {"const": false},
        "git_push": {"const": false},
        "merge": {"const": false},
        "automatic_candidate_selection": {"const": false}
      },
      "description": "The five actuation capabilities are pinned false: this API grants no write, execution, or merge authority regardless of future read-side additions."
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id_header", "liveness", "readiness", "access_log_env",
        "access_logs_include_bodies", "access_logs_include_authentication"
      ],
      "properties": {
        "request_id_header": {"const": "X-Request-ID"},
        "liveness": {"type": "string", "minLength": 1},
        "readiness": {"type": "string", "minLength": 1},
        "access_log_env": {"type": "string", "minLength": 1},
        "access_logs_include_bodies": {"const": false},
        "access_logs_include_authentication": {"const": false},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "The service limits actually in force (ADR-0022). Optional so a bare status document stays valid; the Control Tower server always includes it. `per_client_rate_limit` is `not_implemented`: 429 is reserved until a per-client identity exists.",
          "required": [
            "request_timeout_seconds", "max_concurrent_requests",
            "retry_after_seconds", "drain_timeout_seconds",
            "max_request_line_bytes", "max_header_line_bytes",
            "max_header_count", "max_request_body_bytes",
            "overload_status", "connection_policy", "per_client_rate_limit"
          ],
          "properties": {
            "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_concurrent_requests": {"type": "integer", "minimum": 1},
            "retry_after_seconds": {"type": "integer", "minimum": 0},
            "drain_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_request_line_bytes": {"type": "integer", "minimum": 1},
            "max_header_line_bytes": {"type": "integer", "minimum": 1},
            "max_header_count": {"type": "integer", "minimum": 1},
            "max_request_body_bytes": {"type": "integer", "minimum": 1},
            "overload_status": {"const": 503},
            "connection_policy": {"const": "close_after_response"},
            "per_client_rate_limit": {"const": "not_implemented"}
          }
        }
      }
    },
    "endpoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
