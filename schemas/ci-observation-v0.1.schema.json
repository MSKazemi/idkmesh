{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/ci-observation-v0.1.schema.json",
  "title": "IDKMesh CI Observation v0.1",
  "description": "A normalized exact-revision snapshot of GitHub check runs. It is evidence only and grants no CI or integration authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evaluator_version",
    "source",
    "head_sha",
    "policy_digest",
    "checks",
    "completeness",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "idkmesh-ci-observation"},
    "evaluator_version": {"const": "0.1"},
    "source": {"const": "github-check-runs"},
    "head_sha": {"$ref": "#/$defs/sha"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_complete",
        "baseline_successful",
        "pending_observed_checks",
        "required_contexts"
      ],
      "properties": {
        "baseline_complete": {"type": "boolean"},
        "baseline_successful": {"type": "boolean"},
        "pending_observed_checks": {"type": "integer", "minimum": 0},
        "required_contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow_name", "check_name", "present", "terminal", "successful"],
            "properties": {
              "workflow_name": {"type": "string", "minLength": 1},
              "check_name": {"type": "string", "minLength": 1},
              "present": {"type": "boolean"},
              "terminal": {"type": "boolean"},
              "successful": {"type": "boolean"}
            }
          }
        }
      }
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_run_id",
        "workflow_name",
        "name",
        "app_slug",
        "status",
        "conclusion",
        "started_at",
        "completed_at",
        "details_url"
      ],
      "properties": {
        "check_run_id": {"type": "integer", "minimum": 0},
        "workflow_name": {"type": ["string", "null"], "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "app_slug": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "conclusion": {"type": ["string", "null"]},
        "started_at": {"type": ["string", "null"]},
        "completed_at": {"type": ["string", "null"]},
        "details_url": {"type": ["string", "null"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_only", "execute", "skip_required_checks", "approve", "merge", "repository_write"],
      "properties": {
        "evidence_only": {"const": true},
        "execute": {"const": false},
        "skip_required_checks": {"const": false},
        "approve": {"const": false},
        "merge": {"const": false},
        "repository_write": {"const": false}
      }
    }
  }
}
