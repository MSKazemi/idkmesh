{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/work-unit-v0.2.schema.json",
  "title": "IDKMesh Work Unit v0.2",
  "description": "A bounded, portable unit of work with explicit capabilities, authority, risk, verification, evidence, provenance, and project-spend requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "kind",
    "objective",
    "inputs",
    "outputs",
    "dependencies",
    "requirements",
    "constraints",
    "uncertainty",
    "security",
    "permissions",
    "verification_policy",
    "validators",
    "evidence_requirements",
    "budget",
    "provenance",
    "failure_semantics"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$"},
    "version": {"type": "integer", "minimum": 1},
    "kind": {
      "enum": [
        "coding",
        "testing",
        "review",
        "benchmarking",
        "documentation",
        "research",
        "integration",
        "governance",
        "other"
      ]
    },
    "objective": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {"type": "string"},
        "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "max_context_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactSpec"}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_unit_id", "relationship"],
        "properties": {
          "work_unit_id": {"type": "string", "minLength": 1},
          "relationship": {
            "enum": ["requires", "blocks", "informs", "validates", "derived_from"]
          },
          "condition": {"type": "string"}
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "resources"],
      "properties": {
        "capabilities": {
          "type": "array",
          "description": "Vendor-neutral capabilities required from a worker or execution environment.",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_cores_min", "memory_mb_min", "gpu"],
          "properties": {
            "cpu_cores_min": {"type": "number", "minimum": 0},
            "memory_mb_min": {"type": "integer", "minimum": 0},
            "disk_mb_min": {"type": "integer", "minimum": 0},
            "gpu": {"enum": ["none", "optional", "required"]},
            "accelerator_capabilities": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths", "policies"],
      "properties": {
        "allowed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "policies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "resolution_strategy": {"type": "string"}
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_class", "data_classification", "minimum_worker_trust", "sandbox_required"],
      "properties": {
        "risk_class": {"enum": ["low", "medium", "high", "critical"]},
        "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "minimum_worker_trust": {"enum": ["untrusted", "identified", "trusted", "attested"]},
        "sandbox_required": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem_write", "secrets", "process_execution"],
      "properties": {
        "network": {"enum": ["none", "allowlist", "unrestricted"]},
        "network_allowlist": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "filesystem_write": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "secrets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "process_execution": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"network": {"const": "allowlist"}}},
          "then": {"required": ["network_allowlist"], "properties": {"network_allowlist": {"minItems": 1}}}
        }
      ]
    },
    "verification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "independent_from_worker", "minimum_independent_verifiers"],
      "properties": {
        "strategy": {"enum": ["all_required", "quorum", "threshold", "custom"]},
        "independent_from_worker": {"type": "boolean"},
        "minimum_independent_verifiers": {"type": "integer", "minimum": 0},
        "quorum": {"type": "integer", "minimum": 1},
        "acceptance_rule": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "quorum"}}},
          "then": {"required": ["quorum"]}
        }
      ]
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["test", "review", "schema", "lint", "security", "formal", "reproduction", "benchmark", "other"]},
          "required": {"type": "boolean"},
          "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "description": {"type": "string"}
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "required"],
        "properties": {
          "type": {"enum": ["test_output", "review", "benchmark", "citation", "trace", "attestation", "artifact_hash", "other"]},
          "required": {"type": "boolean"},
          "description": {"type": "string"}
        }
      }
    },
    "budget": {
      "type": "object",
      "description": "Resource limits. project_spend_usd_max is the maximum amount IDKMesh itself may pay for this Work Unit; donor electricity/hardware is tracked separately and must be voluntary and transparent.",
      "additionalProperties": false,
      "required": ["project_spend_usd_max", "paid_fallback_allowed"],
      "properties": {
        "wall_seconds": {"type": "number", "minimum": 0},
        "compute_units": {"type": "number", "minimum": 0},
        "human_minutes": {"type": "number", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "project_spend_usd_max": {"type": "number", "minimum": 0},
        "paid_fallback_allowed": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "creator_type", "source"],
      "properties": {
        "created_by": {"type": "string", "minLength": 1},
        "creator_type": {"enum": ["human", "agent", "hybrid", "system"]},
        "source": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "parent_work_unit_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "failure_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retryable", "max_attempts", "on_failure"],
      "properties": {
        "retryable": {"type": "boolean"},
        "max_attempts": {"type": "integer", "minimum": 1},
        "on_failure": {"enum": ["stop", "retry", "replan", "escalate", "continue_degraded"]}
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced experimental fields. Keys SHOULD use reverse-DNS or project prefixes.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "locator"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["file", "directory", "git_ref", "dataset", "url", "text", "json", "other"]},
        "locator": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "artifactSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["patch", "file", "report", "test_result", "dataset", "decision", "review", "other"]},
        "description": {"type": "string", "minLength": 1},
        "media_type": {"type": "string"}
      }
    }
  }
}
