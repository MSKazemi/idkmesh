{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/decomposition-benchmark-v0.1.schema.json",
  "title": "IDKMesh Work Unit Decomposition Benchmark v0.1",
  "description": "A five-arm decomposition comparison with explicit per-unit observations and evidence classification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "task_class", "task_description", "evidence_class", "workers", "provenance", "arms"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "task_class": {"type": "string", "minLength": 1},
    "task_description": {"type": "string", "minLength": 1},
    "evidence_class": {"enum": ["synthetic_fixture", "observed"], "description": "Synthetic fixtures test infrastructure only; only observed independent runs may support scientific claims."},
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "worker_type", "implementation", "revision"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "worker_type": {"enum": ["human", "agent", "hybrid", "synthetic"]},
          "implementation": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_revision", "recorded_by"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "recorded_by": {"type": "string", "minLength": 1}
      }
    },
    "arms": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/arm"}}
  },
  "$defs": {
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "units", "observations"],
      "properties": {
        "strategy": {"enum": ["monolithic", "human_subtasks", "file_module", "dependency_dag", "formal_work_units"]},
        "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "dependencies", "allowed_paths", "global_context_required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allowed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "global_context_required": {"type": "boolean"},
        "formal_work_unit_path": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "worker_id", "unit_id", "completed", "integration_failed", "merge_conflicts", "rework_cycles", "context_bytes", "cross_worker_messages", "hidden_tests_passed", "hidden_tests_total", "assumption_mismatches", "dependency_violations", "verification_seconds", "human_integration_minutes"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "worker_id": {"type": "string", "minLength": 1},
        "unit_id": {"type": "string", "minLength": 1},
        "completed": {"type": "boolean"},
        "integration_failed": {"type": "boolean"},
        "merge_conflicts": {"type": "integer", "minimum": 0},
        "rework_cycles": {"type": "integer", "minimum": 0},
        "context_bytes": {"type": "integer", "minimum": 0},
        "cross_worker_messages": {"type": "integer", "minimum": 0},
        "hidden_tests_passed": {"type": "integer", "minimum": 0},
        "hidden_tests_total": {"type": "integer", "minimum": 0},
        "assumption_mismatches": {"type": "integer", "minimum": 0},
        "dependency_violations": {"type": "integer", "minimum": 0},
        "verification_seconds": {"type": "number", "minimum": 0},
        "human_integration_minutes": {"type": "number", "minimum": 0}
      }
    }
  }
}
