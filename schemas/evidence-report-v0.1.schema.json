{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/evidence-report-v0.1.schema.json",
  "title": "IDKMesh Evidence Report v0.1",
  "description": "An independent verifier report about a worker candidate. Evidence Reports may support or reject a candidate but do not themselves grant repository acceptance or merge authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "work_unit_id",
    "work_unit_version",
    "result_manifest",
    "validator_id",
    "verifier",
    "independence",
    "started_at",
    "finished_at",
    "verdict",
    "evaluated_artifacts",
    "checks",
    "evidence_artifacts",
    "resources",
    "summary",
    "provenance",
    "acceptance_scope"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$"},
    "work_unit_id": {"type": "string", "minLength": 1},
    "work_unit_version": {"type": "integer", "minimum": 1},
    "result_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "worker_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "worker_id": {"type": "string", "minLength": 1}
      }
    },
    "validator_id": {"type": "string", "minLength": 1},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "adapter"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["human", "agent", "system", "hybrid"]},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "provider": {"type": "string"},
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string"}
          }
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship", "basis"],
      "properties": {
        "relationship": {"enum": ["independent", "partially_independent", "unknown"]},
        "basis": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["separate_process", "separate_adapter", "separate_model", "separate_human", "hidden_tests", "isolated_credentials", "separate_organization", "other"]}
        },
        "notes": {"type": "string"}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "verdict": {"enum": ["supports_candidate", "rejects_candidate", "inconclusive", "verifier_error"]},
    "evaluated_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "digest"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["test", "hidden_test", "lint", "security", "review", "reproduction", "schema", "policy", "formal", "other"]},
          "required": {"type": "boolean"},
          "status": {"enum": ["pass", "fail", "error", "skipped"]},
          "detail": {"type": "string"},
          "evidence_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "locator", "digest"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["test_output", "review", "benchmark", "trace", "attestation", "artifact_hash", "security_report", "other"]},
          "locator": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "media_type": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds"],
      "properties": {
        "wall_seconds": {"type": "number", "minimum": 0},
        "cpu_seconds": {"type": "number", "minimum": 0},
        "compute_units": {"type": "number", "minimum": 0},
        "human_minutes": {"type": "number", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "limitations"],
      "properties": {
        "statement": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_digest", "verifier_config_digest", "environment"],
      "properties": {
        "work_unit_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_revision": {"type": "string"},
        "verifier_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {"type": "string"},
            "python": {"type": "string"},
            "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "acceptance_scope": {"const": "evidence_only"},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
