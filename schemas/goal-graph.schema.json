{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/goal-graph.schema.json",
  "title": "IDKMesh Goal Graph",
  "description": "A graph for uncertain goals, competing hypotheses, work, evidence, risks, decisions, and provenance.",
  "type": "object",
  "required": ["schema_version", "graph_id", "nodes", "edges"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "graph_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "goal",
            "question",
            "assumption",
            "hypothesis",
            "requirement",
            "constraint",
            "proposal",
            "work_unit",
            "artifact",
            "test",
            "evidence",
            "decision",
            "risk",
            "failure",
            "metric",
            "participant",
            "agent",
            "compute_node",
            "other"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["proposed", "active", "supported", "contested", "blocked", "verified", "rejected", "superseded", "resolved", "archived"]
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "priority": { "type": ["number", "null"], "minimum": 0 },
        "novelty": { "type": ["number", "null"], "minimum": 0 },
        "information_value": { "type": ["number", "null"], "minimum": 0 },
        "risk_level": { "type": ["string", "null"], "enum": ["low", "medium", "high", "critical", null] },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": { "type": "string" },
              "uri": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
            },
            "additionalProperties": true
          }
        },
        "attributes": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "depends_on",
            "supports",
            "contradicts",
            "implements",
            "verifies",
            "derived_from",
            "supersedes",
            "blocks",
            "produced_by",
            "tests",
            "measures",
            "mitigates",
            "challenges",
            "motivates",
            "decomposes_into",
            "related_to",
            "other"
          ]
        },
        "weight": { "type": ["number", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "attributes": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
