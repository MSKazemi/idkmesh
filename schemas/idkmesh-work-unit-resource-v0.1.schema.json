{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/idkmesh-work-unit-resource-v0.1.schema.json",
  "title": "IDKMesh WorkUnit Resource v0.1",
  "description": "One item of `GET /api/v1/work-units` and the `work_unit` member of `GET /api/v1/work-units/{work_unit_id}`. A read model derived on demand from the WorkUnit references stored in Product Spine runs (ADR-0021): no WorkUnit body is stored or returned, `digest` is the binding for the body, and no revision is selected as latest. `revisions` is ordered ascending by (version, digest, source_revision). Under a `project_id` filter, run counts include only that project's runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_count",
    "revisions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "run_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Sum of the revisions' run_count."
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "digest",
          "source_revision",
          "run_count"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
          },
          "run_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
