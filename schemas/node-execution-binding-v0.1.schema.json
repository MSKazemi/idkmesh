{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/node-execution-binding-v0.1.schema.json",
  "title": "IDKMesh Node Execution Binding v0.1",
  "description": "Execution-specific settings carried inside Work Unit extensions under org.idkmesh.node.execution. This is not a second Work Unit schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_input_id",
    "source_revision",
    "capabilities",
    "container",
    "limits",
    "output_limits"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source_input_id": {"type": "string", "minLength": 1},
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "Immutable 40-character Git commit identifier for the source input. Kept in the execution binding because canonical WorkUnit artifact digests are content SHA-256 values, not Git revision identifiers."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "description": "Capabilities provided by this execution profile and checked against WorkUnit requirements.capabilities."
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "command"],
      "properties": {
        "image": {"type": "string", "minLength": 1, "maxLength": 256},
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "cpus", "memory_mb", "pids_limit"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "cpus": {"type": "number", "minimum": 0.1, "maximum": 8.0},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 16384},
        "pids_limit": {"type": "integer", "minimum": 16, "maximum": 1024}
      }
    },
    "output_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_patch_bytes", "max_log_bytes"],
      "properties": {
        "max_patch_bytes": {"type": "integer", "minimum": 1024, "maximum": 10000000},
        "max_log_bytes": {"type": "integer", "minimum": 1024, "maximum": 2000000}
      }
    }
  }
}
