{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/idkmesh-event-v0.1.schema.json",
  "title": "IDKMesh Event v0.1",
  "description": "One durable event of the canonical append-only stream (ADR-0023): an item of `GET /api/v1/events`, the `data:` payload of `GET /api/v1/events/stream`, and an item of `idkmesh events list`. `sequence` is the stream's monotonic position (resume with `Last-Event-ID: <sequence>`); `event_id` is unique within the stream so clients can dedupe at-least-once delivery. `occurred_at` is supplied by the producer of the state change, never read from a clock by the store. `authority_class` keeps recommendations and decisions distinguishable: v0.1 emits only `local_control`; the other classes are reserved. `payload_digest` is the sha256 of the canonical JSON of `payload`. Coverage in v0.1 is Product Spine run create and cancel only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "event_id",
    "sequence",
    "occurred_at",
    "event_type",
    "principal",
    "authority_class",
    "project_id",
    "work_unit_id",
    "run_id",
    "attempt_id",
    "source_revision",
    "evidence_reference",
    "payload",
    "payload_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "idkmesh-event"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9]{12}$(?!\n)"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$(?!\n)"
    },
    "event_type": {
      "enum": [
        "run.created",
        "run.cancelled"
      ]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_class": {
      "enum": [
        "local_control",
        "worker_observation",
        "verifier_recommendation",
        "human_decision"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$(?!\n)"
    },
    "evidence_reference": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "payload": {
      "type": "object"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?!\n)"
    }
  }
}
