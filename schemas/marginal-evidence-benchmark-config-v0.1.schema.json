{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/marginal-evidence-benchmark-config-v0.1.schema.json",
  "title": "IDKMesh Marginal Evidence Benchmark Config v0.1",
  "description": "Preregistered design/holdout benchmark configuration for issue #693. Selection rules are fixed by implementation version; holdout rows are evaluation-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "design_matrix",
    "holdout_matrix",
    "current_verifier_ids",
    "candidate_verifier_ids",
    "verifier_families",
    "random_seed",
    "bootstrap"
  ],
  "properties": {
    "schema": {"const": "marginal-evidence-benchmark-config-v0.1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "design_matrix": {"type": "string", "minLength": 1},
    "holdout_matrix": {"type": "string", "minLength": 1},
    "current_verifier_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_verifier_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verifier_families": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "random_seed": {"type": "integer"},
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicates", "seed", "confidence_level"],
      "properties": {
        "replicates": {"type": "integer", "minimum": 100},
        "seed": {"type": "integer"},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    }
  }
}
