{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/evaluator-plan-v0.2.schema.json",
  "title": "IDKMesh Evaluator Plan v0.2",
  "description": "Verifier-owned metadata-only plan binding a deterministic unified-diff evaluator to one exact WorkUnit and source revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "binding",
    "visibility",
    "execution_mode",
    "verifier",
    "required_validator_ids",
    "candidate_artifact_id",
    "backend",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_id", "work_unit_version", "work_unit_digest", "source_revision"],
      "properties": {
        "work_unit_id": {"type": "string", "minLength": 1},
        "work_unit_version": {"type": "integer", "minimum": 1},
        "work_unit_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_revision": {"type": "string", "minLength": 1}
      }
    },
    "visibility": {"enum": ["public", "hidden"]},
    "execution_mode": {"const": "metadata_only"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "adapter", "adapter_version"],
      "properties": {
        "id": {"const": "idkmesh-local-verifier"},
        "type": {"const": "system"},
        "adapter": {"const": "deterministic-patch-verifier"},
        "adapter_version": {"const": "0.1"}
      }
    },
    "required_validator_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "candidate_artifact_id": {"type": "string", "minLength": 1},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "max_candidate_bytes",
        "max_log_bytes",
        "required_added_text",
        "require_nonempty_patch",
        "verify_log_digests"
      ],
      "properties": {
        "type": {"const": "unified_diff"},
        "max_candidate_bytes": {"type": "integer", "minimum": 1},
        "max_log_bytes": {"type": "integer", "minimum": 1},
        "required_added_text": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "require_nonempty_patch": {"const": true},
        "verify_log_digests": {"const": true}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_plan_outside_candidate_root",
        "require_output_outside_candidate_root",
        "require_verifier_distinct_from_worker"
      ],
      "properties": {
        "require_plan_outside_candidate_root": {"const": true},
        "require_output_outside_candidate_root": {"const": true},
        "require_verifier_distinct_from_worker": {"const": true}
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
