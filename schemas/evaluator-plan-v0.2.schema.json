{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/evaluator-plan-v0.2.schema.json",
  "title": "IDKMesh Evaluator Plan v0.2",
  "description": "Verifier-owned plan binding repository-patch evaluation and hidden checks to one exact WorkUnit/source revision. v0.2 extends the metadata-only EvaluatorPlan lineage rather than introducing a parallel verifier-plan protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "binding",
    "visibility",
    "execution_mode",
    "verifier",
    "required_validator_ids",
    "source_input_id",
    "candidate_artifact_id",
    "container_image",
    "checks",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_id", "work_unit_version", "work_unit_digest", "source_revision"],
      "properties": {
        "work_unit_id": {"type": "string", "minLength": 1},
        "work_unit_version": {"type": "integer", "minimum": 1},
        "work_unit_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "visibility": {"enum": ["public", "hidden"]},
    "execution_mode": {"const": "repository_patch"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "adapter", "adapter_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "type": {"const": "system"},
        "adapter": {"type": "string", "minLength": 1, "maxLength": 200},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "required_validator_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_input_id": {"type": "string", "minLength": 1},
    "candidate_artifact_id": {"type": "string", "minLength": 1},
    "container_image": {"type": "string", "minLength": 1, "maxLength": 256},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required", "mode"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200},
          "type": {"enum": ["test", "review", "schema", "lint", "security", "formal", "reproduction", "policy", "other"]},
          "required": {"type": "boolean"},
          "mode": {"enum": ["result_schema", "artifact_integrity", "scope_policy", "container_command"]},
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 4096}
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
          "description": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"mode": {"const": "container_command"}}, "required": ["mode"]},
            "then": {"required": ["command"]}
          }
        ]
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_plan_outside_candidate_root",
        "require_output_outside_candidate_root",
        "require_verifier_distinct_from_worker",
        "fresh_workspace_per_container_check"
      ],
      "properties": {
        "require_plan_outside_candidate_root": {"const": true},
        "require_output_outside_candidate_root": {"const": true},
        "require_verifier_distinct_from_worker": {"const": true},
        "fresh_workspace_per_container_check": {"const": true}
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
