{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idkmesh.org/schemas/work-unit.schema.json",
  "title": "IDKMesh Work Unit",
  "description": "A bounded unit of useful work that can be scheduled, executed, reproduced, and independently verified.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "goal_ref",
    "task_type",
    "description",
    "verification_policy",
    "privacy_class"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "goal_ref": { "type": "string", "minLength": 1 },
    "parent_work_unit_id": { "type": ["string", "null"] },
    "task_type": {
      "type": "string",
      "enum": [
        "research",
        "decompose",
        "implement",
        "test",
        "verify",
        "review",
        "benchmark",
        "simulate",
        "analyze",
        "document",
        "integrate",
        "other"
      ]
    },
    "description": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["artifact", "repository", "dataset", "text", "url", "other"] },
          "uri": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "required": { "type": "boolean", "default": true }
        },
        "additionalProperties": true
      },
      "default": []
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "required_capabilities": {
      "type": "object",
      "properties": {
        "operating_systems": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "architectures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "gpu": { "type": "boolean" },
        "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "model_families": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true,
      "default": {}
    },
    "resource_hints": {
      "type": "object",
      "properties": {
        "cpu_cores": { "type": "number", "minimum": 0 },
        "memory_mb": { "type": "integer", "minimum": 0 },
        "gpu_memory_mb": { "type": "integer", "minimum": 0 },
        "disk_mb": { "type": "integer", "minimum": 0 },
        "estimated_seconds": { "type": "number", "minimum": 0 },
        "max_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true,
      "default": {}
    },
    "execution_constraints": {
      "type": "object",
      "properties": {
        "network": { "type": "string", "enum": ["none", "allowlist", "unrestricted"] },
        "filesystem": { "type": "string", "enum": ["ephemeral", "workspace-read", "workspace-write"] },
        "secrets_allowed": { "type": "boolean", "default": false },
        "deterministic_requested": { "type": "boolean", "default": false },
        "sandbox_required": { "type": "boolean", "default": true }
      },
      "additionalProperties": true,
      "default": { "network": "none", "filesystem": "ephemeral", "secrets_allowed": false, "sandbox_required": true }
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "required": { "type": "boolean", "default": true }
        },
        "additionalProperties": true
      },
      "default": []
    },
    "verification_policy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["none", "deterministic", "independent", "quorum", "adversarial", "hybrid"] },
        "min_verifiers": { "type": "integer", "minimum": 0, "default": 1 },
        "replication_factor": { "type": "integer", "minimum": 1, "default": 1 },
        "required_checks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "diversity_dimensions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "human_escalation_on_disagreement": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "privacy_class": {
      "type": "string",
      "enum": ["public", "restricted", "private-local", "confidential"]
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
    "deadline": { "type": ["string", "null"], "format": "date-time" },
    "random_seed": { "type": ["integer", "null"] },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" },
    "provenance_requirements": {
      "type": "object",
      "properties": {
        "content_hashes": { "type": "boolean", "default": true },
        "environment_manifest": { "type": "boolean", "default": true },
        "signature": { "type": "boolean", "default": false },
        "logs": { "type": "boolean", "default": true }
      },
      "additionalProperties": true,
      "default": {}
    }
  },
  "additionalProperties": true
}
